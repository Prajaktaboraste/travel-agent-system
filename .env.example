# Copy to .env and edit. Everything is optional - the app runs fully offline with defaults.
DB_PATH=data/travel.db
KNOWLEDGE_DIR=data/knowledge
ADMIN_API_KEY=change-me
SEED_DEMO=1

# Email agent (if SMTP_HOST is empty, emails are stored in the outbox as "simulated")
NOTIFY_EMAILS=admin@example.com,manager@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=travel-agent@example.com

# Optional LLM for nicer RAG answers (falls back to extractive answers if empty/unreachable)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
